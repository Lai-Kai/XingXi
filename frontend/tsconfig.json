{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": false,
    "checkJs": false,
    /* Bundled projects */
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-production/types/**/*.ts",
    ".next-production/dev/types/**/*.ts",
    ".next-releases/upload-button-20261021/types/**/*.ts",
    ".next-releases/upload-button-20261021/dev/types/**/*.ts",
    ".next-releases/upload-button-20261021-v2/types/**/*.ts",
    ".next-releases/upload-button-20261021-v2/dev/types/**/*.ts",
    ".next-releases/reconstruction-reliability-20261024/types/**/*.ts",
    ".next-releases/reconstruction-reliability-20261024/dev/types/**/*.ts",
    ".next-releases/map-model-rounds-20261025/types/**/*.ts",
    ".next-releases/map-model-rounds-20261025/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "generated"
  ]
}
